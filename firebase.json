{
	"hosting": {
		"public": "public",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**", "firebase-debug.log",".zshrc"],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		],
		"headers": [
			{
			  "source": "**/*.pdf",
			  "headers": [
				{ "key": "Content-Type", "value": "application/pdf" }
			  ]
			}
		  ]
	}
}
